<view class="page">
  <view class="hero">
    <view class="hero-date">{{todayStr}}</view>
    <view class="hero-lunar">{{lunarToday}}</view>
  </view>

  <view class="tabs">
    <view class="tab {{tab==='birthday'?'active':''}}" data-tab="birthday" bindtap="switchTab">生日</view>
    <view class="tab {{tab==='festival'?'active':''}}" data-tab="festival" bindtap="switchTab">节日</view>
    <view class="tab {{tab==='weekend'?'active':''}}" data-tab="weekend" bindtap="switchTab">周末</view>
  </view>

  <block wx:if="{{tab==='birthday'}}">
    <view wx:if="{{pending.length}}" class="banner" bindtap="onSyncAll">
      <view class="banner-text">
        <view class="banner-title">有 {{pending.length}} 个生日提醒待补充</view>
        <view class="banner-sub">写入系统日历后会自动提醒</view>
      </view>
      <view class="banner-btn">一键补充</view>
    </view>

    <view wx:if="{{!birthdays.length}}" class="empty">
      <view class="empty-title">还没有生日记录</view>
      <view class="empty-sub">点右下角 + 添加第一个</view>
    </view>

    <view wx:for="{{birthdays}}" wx:key="id" class="bcard card" bindtap="onEdit" data-id="{{item.id}}">
      <view class="bcard-left">
        <view class="bcard-name">{{item.name}}</view>
        <view class="bcard-meta">
          <text wx:if="{{item.relation}}" class="tag">{{item.relation}}</text>
          <text class="meta-text">{{item.dateLabel}}</text>
        </view>
        <view class="bcard-note" wx:if="{{item.note}}">{{item.note}}</view>
      </view>
      <view class="bcard-right">
        <view class="days {{item.days===0?'today':''}}">
          <text wx:if="{{item.days===0}}">今天</text>
          <block wx:else>
            <text class="days-num">{{item.days}}</text>
            <text class="days-unit">天</text>
          </block>
        </view>
        <view class="bcard-occ">{{item.occDateStr}}</view>
        <view class="bcard-age" wx:if="{{item.ageText}}">{{item.ageText}}</view>
      </view>
      <view wx:if="{{item.needSync}}" class="cal-btn" catchtap="onSyncOne" data-id="{{item.id}}">加日历</view>
    </view>
  </block>

  <block wx:elif="{{tab==='festival'}}">
    <view wx:for="{{festivals}}" wx:key="key" class="fcard card">
      <view class="fcard-left">
        <view class="fcard-name">{{item.name}}</view>
        <view class="fcard-type">{{item.type==='lunar'?'农历':'公历'}}</view>
      </view>
      <view class="fcard-right">
        <view class="fcard-days">{{item.days===0?'今天':item.days+' 天后'}}</view>
        <view class="fcard-date">{{item.dateStr}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{tab==='weekend'}}">
    <view wx:for="{{weekend}}" wx:key="name" class="fcard card">
      <view class="fcard-left">
        <view class="fcard-name">{{item.name}}</view>
      </view>
      <view class="fcard-right">
        <view class="fcard-days">{{item.label}}</view>
        <view class="fcard-date">{{item.dateStr}}</view>
      </view>
    </view>
  </block>

  <view wx:if="{{tab==='birthday'}}" class="fab" bindtap="onAdd">+</view>
</view>
